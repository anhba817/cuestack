{
  "name": "@cuestack/react",
  "version": "0.1.0",
  "description": "Cuestack React adapter — server-rendered, hydrating lesson player",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown && node ../../tools/scripts/bundle-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "dependencies": {
    "@cuestack/core": "workspace:*",
    "@cuestack/schema": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "4.13.0",
    "happy-dom": "20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "keywords": [
    "cuestack",
    "lesson",
    "player",
    "react",
    "rsc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhba817/cuestack.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/anhba817/cuestack/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/anhba817/cuestack/issues"
  }
}
