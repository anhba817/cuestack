{
  "name": "@cuestack/schema",
  "version": "0.1.0",
  "description": "The Cuestack lesson format: types, validators, and migrations",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "fixtures/valid"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    },
    "./package.json": "./package.json",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cuestack",
    "lesson",
    "schema",
    "validation",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhba817/cuestack.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/anhba817/cuestack/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/anhba817/cuestack/issues"
  }
}
