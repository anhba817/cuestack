{
  "name": "@cuestack/studio",
  "version": "0.0.0",
  "description": "Cuestack Studio — the authoring canvas and properties inspector",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node ../../tools/scripts/copy-css.mjs studio src/styles/editor.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@cuestack/core": "workspace:*",
    "@cuestack/react": "workspace:*",
    "@cuestack/schema": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "4.13.0",
    "happy-dom": "20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "keywords": [
    "cuestack",
    "lesson",
    "authoring",
    "editor",
    "timeline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhba817/cuestack.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/anhba817/cuestack/tree/main/packages/studio#readme",
  "bugs": {
    "url": "https://github.com/anhba817/cuestack/issues"
  }
}
