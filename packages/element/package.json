{
  "name": "@cuestack/element",
  "version": "0.1.0",
  "description": "Cuestack web-component adapter: plays a lesson with no UI framework. A proof, not a second player — no video, audio, or questions, and no server rendering. See README.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cuestack/core": "workspace:*",
    "@cuestack/schema": "workspace:*"
  },
  "devDependencies": {
    "@cuestack/react": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "axe-core": "4.13.0"
  },
  "keywords": [
    "cuestack",
    "lesson",
    "player",
    "web-components",
    "custom-elements"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhba817/cuestack.git",
    "directory": "packages/element"
  },
  "homepage": "https://github.com/anhba817/cuestack/tree/main/packages/element#readme",
  "bugs": {
    "url": "https://github.com/anhba817/cuestack/issues"
  }
}
